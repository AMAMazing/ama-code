{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$tsc",
			"label": "npm: compile",
			"detail": "Compile the extension"
		},
		{
			"type": "npm",
			"script": "watch:esbuild",
			"isBackground": true,
			"problemMatcher": "$esbuild-watch",
			"label": "npm: watch:esbuild",
			"detail": "Watch and bundle extension with esbuild"
		}
	]
}