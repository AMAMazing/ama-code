{
	"name": "ama-code",
	"displayName": "AMA Code",
	"description": "Autonomous coding agent right in your IDE, capable of creating/editing files, running commands, using the browser, and more with your permission every step of the way.",
	"version": "1.30.0",
	"icon": "assets/icons/icon.png",
	"engines": {
		"vscode": "^1.84.0"
	},
	"author": {
		"name": "AMA Code"
	},
	"license": "Apache-2.0",
	"publisher": "AMAMazing",
	"repository": {
		"type": "git",
		"url": "https://github.com/AMAMazing/ama-code"
	},
	"homepage": "https://github.com/AMAMazing/ama-code",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"ama-code",
		"coding",
		"agent",
		"autonomous",
		"openai",
		"ai"
	],
	"activationEvents": [
		"onLanguage",
		"onUri",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"icons": {
			"cline-icon": {
				"description": "AMA Code",
				"default": {
					"fontPath": "assets/icons/cline-bot.woff",
					"fontCharacter": "\\e900"
				}
			}
		},
		"walkthroughs": [
			{
				"id": "ClineWalkthrough",
				"title": "Meet AMA Code, your new coding partner",
				"description": "AMA Code codes like a developer because it thinks like one. Here are 5 ways to put it to work:",
				"steps": [
					{
						"id": "welcome",
						"title": "Start with a Goal, Not Just a Prompt",
						"description": "Tell AMA Code what you want to achieve. It plans, asks, and then codes, like a true partner.",
						"media": {
							"markdown": "walkthrough/step1.md"
						}
					},
					{
						"id": "learn",
						"title": "Let AMA Code Learn Your Codebase",
						"description": "Point AMA Code to your project. It builds understanding to make smart, context-aware changes.",
						"media": {
							"markdown": "walkthrough/step2.md"
						}
					},
					{
						"id": "advanced-features",
						"title": "Always Use the Best AI Models",
						"description": "AMA Code empowers you with State-of-the-Art AI via OpenAI Compatible endpoints.",
						"media": {
							"markdown": "walkthrough/step3.md"
						}
					},
					{
						"id": "mcp",
						"title": "Extend with Powerful Tools (MCP)",
						"description": "Connect to databases, APIs, or discover new capabilities in the MCP Marketplace.",
						"media": {
							"markdown": "walkthrough/step4.md"
						}
					},
					{
						"id": "getting-started",
						"title": "You're Always in Control",
						"description": "Review AMA Code's plans and diffs. Approve changes before they happen. No surprises.",
						"media": {
							"markdown": "walkthrough/step5.md"
						},
						"content": {
							"path": "walkthrough/step5.md"
						}
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "ama-code-ActivityBar",
					"title": "AMA Code",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"ama-code-ActivityBar": [
				{
					"type": "webview",
					"id": "ama-code.SidebarProvider",
					"name": "",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "ama-code.plusButtonClicked",
				"title": "New Task",
				"icon": "$(add)"
			},
			{
				"command": "ama-code.mcpButtonClicked",
				"title": "MCP Servers",
				"icon": "$(server)"
			},
			{
				"command": "ama-code.historyButtonClicked",
				"title": "History",
				"icon": "$(history)"
			},
			{
				"command": "ama-code.settingsButtonClicked",
				"title": "Settings",
				"icon": "$(settings-gear)"
			},
			{
				"command": "cline.dev.createTestTasks",
				"title": "Create Test Tasks",
				"category": "AMA Code",
				"when": "cline.isDevMode"
			},
			{
				"command": "cline.dev.expireMcpOAuthTokens",
				"title": "Expire MCP OAuth Tokens (for testing)",
				"category": "AMA Code",
				"when": "cline.isDevMode"
			},
			{
				"command": "ama-code.addToChat",
				"title": "Add to AMA Code",
				"category": "AMA Code"
			},
			{
				"command": "ama-code.addTerminalOutputToChat",
				"title": "Add to AMA Code",
				"category": "AMA Code"
			},
			{
				"command": "ama-code.focusChatInput",
				"title": "Jump to Chat Input",
				"category": "AMA Code"
			},
			{
				"command": "ama-code.generateGitCommitMessage",
				"title": "Generate Commit Message with AMA Code",
				"category": "AMA Code",
				"icon": "$(cline-icon)"
			},
			{
				"command": "ama-code.abortGitCommitMessage",
				"title": "Generate Commit Message with AMA Code - Stop",
				"category": "AMA Code",
				"icon": "$(debug-stop)"
			},
			{
				"command": "ama-code.explainCode",
				"title": "Explain with AMA Code",
				"category": "AMA Code"
			},
			{
				"command": "ama-code.improveCode",
				"title": "Improve with AMA Code",
				"category": "AMA Code"
			},
			{
				"command": "ama-code.jupyterGenerateCell",
				"title": "Generate Jupyter Cell with AMA Code",
				"category": "AMA Code",
				"icon": "$(sparkle)"
			},
			{
				"command": "ama-code.jupyterExplainCell",
				"title": "Explain Jupyter Cell with AMA Code",
				"category": "AMA Code",
				"icon": "$(question)"
			},
			{
				"command": "ama-code.jupyterImproveCell",
				"title": "Improve Jupyter Cell with AMA Code",
				"category": "AMA Code",
				"icon": "$(lightbulb)"
			},
			{
				"command": "ama-code.openWalkthrough",
				"title": "Open Walkthrough",
				"category": "AMA Code"
			},
			{
				"command": "ama-code.reconstructTaskHistory",
				"title": "Reconstruct Task History",
				"category": "AMA Code"
			},
			{
				"command": "ama-code.openManualModePanel",
				"title": "Open Manual Mode Panel",
				"category": "AMA Code"
			},
			{
				"command": "cline.reviewComment.reply",
				"title": "Reply",
				"category": "AMA Code",
				"enablement": "!commentIsEmpty"
			},
			{
				"command": "cline.reviewComment.addToChat",
				"title": "Add to AMA Code Chat",
				"category": "AMA Code",
				"icon": "$(link-external)"
			}
		],
		"keybindings": [
			{
				"command": "editor.action.submitComment",
				"key": "enter",
				"when": "commentEditorFocused && commentController == cline-ai-review && !commentIsEmpty"
			},
			{
				"command": "ama-code.addToChat",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "editorHasSelection"
			},
			{
				"command": "ama-code.generateGitCommitMessage",
				"when": "config.git.enabled && scmProvider == git"
			},
			{
				"command": "ama-code.focusChatInput",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "!editorHasSelection"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "ama-code.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == ama-code.SidebarProvider"
				},
				{
					"command": "ama-code.mcpButtonClicked",
					"group": "navigation@2",
					"when": "view == ama-code.SidebarProvider"
				},
				{
					"command": "ama-code.historyButtonClicked",
					"group": "navigation@3",
					"when": "view == ama-code.SidebarProvider"
				},
				{
					"command": "ama-code.settingsButtonClicked",
					"group": "navigation@6",
					"when": "view == ama-code.SidebarProvider"
				}
			],
			"editor/context": [
				{
					"command": "ama-code.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "ama-code.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [
				{
					"command": "ama-code.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !cline.isGeneratingCommit"
				},
				{
					"command": "ama-code.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && cline.isGeneratingCommit"
				}
			],
			"notebook/toolbar": [
				{
					"command": "ama-code.jupyterGenerateCell",
					"group": "navigation/add@1",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"notebook/cell/title": [
				{
					"command": "ama-code.jupyterExplainCell",
					"group": "inline@1",
					"when": "notebookType == 'jupyter-notebook'"
				},
				{
					"command": "ama-code.jupyterImproveCell",
					"group": "inline@2",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"commandPalette": [
				{
					"command": "ama-code.generateGitCommitMessage",
					"when": "config.git.enabled && !cline.isGeneratingCommit"
				},
				{
					"command": "ama-code.abortGitCommitMessage",
					"when": "config.git.enabled && cline.isGeneratingCommit"
				},
				{
					"command": "cline.reviewComment.reply",
					"when": "false"
				}
			],
			"comments/commentThread/context": [
				{
					"command": "cline.reviewComment.reply",
					"group": "inline",
					"when": "commentController == cline-ai-review"
				}
			],
			"comments/commentThread/title": [
				{
					"command": "cline.reviewComment.addToChat",
					"group": "inline",
					"when": "commentController == cline-ai-review"
				}
			]
		},
		"configuration": {
			"title": "AMA Code",
			"properties": {}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.mjs",
		"dev": "npm run protos && npm run watch",
		"watch": "npx npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run protos && npm-run-all -p build:webview build:extension",
		"package:vsix": "npx vsce package --no-dependencies --allow-package-secrets sendgrid",
		"protos": "node scripts/build-proto.mjs",
		"download-ripgrep": "node scripts/download-ripgrep.mjs",
		"postprotos": "biome format --config-path ./biome.jsonc src/shared/proto src/core/controller src/hosts/ webview-ui/src/services src/generated --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist dist-standalone webview-ui/build src/generated out/",
		"clean:deps": "rimraf node_modules webview-ui/node_modules",
		"clean:all": "npm run clean:build && npm run clean:deps",
		"check-types": "npm run protos && tsc --noEmit && cd webview-ui && tsc --noEmit",
		"lint": "biome lint --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && npm run lint:proto",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"format": "biome format --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error",
		"format:fix": "biome check --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --write",
		"fix:all": "biome check --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe",
		"install:all": "npm install && cd webview-ui && npm install",
		"sync:ambient": "node scripts/sync-ambient-language.mjs",
		"sync:ambient:pull": "node scripts/sync-ambient-language.mjs --pull",
		"dev:webview": "npm run sync:ambient && cd webview-ui && npm run dev",
		"build:webview": "npm run sync:ambient && cd webview-ui && npm run build",
		"build:extension": "node esbuild.mjs --production",
		"publish:marketplace": "node scripts/publish-marketplace.mjs",
		"publish:marketplace:prerelease": "node scripts/publish-marketplace.mjs --pre-release",
		"prepare": "npx husky"
	},
	"lint-staged": {
		"src/shared/storage/state-keys.ts": [
			"node scripts/generate-state-proto.mjs",
			"git add proto/cline/state.proto"
		],
		"*": [
			"biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
